# ===== 应用配置 =====
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite 本地开发；PostgreSQL 正式部署示例：
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/quizdb
DATABASE_URL=sqlite:///./quiz_platform.db

# ===== AI 服务（OpenAI 兼容接口） =====
# 不配置时 AI 功能返回"开发占位"状态，不影响刷题
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
AI_MAX_TOKENS=2048

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
